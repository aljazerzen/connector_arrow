_default:
    just list

start:
    podman run --detach --replace --name connector-arrow-postgres --publish 5432:5432 --env POSTGRES_DB=db --env POSTGRES_USER=user --env POSTGRES_PASSWORD=pass --health-cmd 'pg_isready -U user -d db' --health-interval 5s --health-timeout 5s --health-retries 5 postgres:16-alpine
    podman run --detach --replace --name connector-arrow-mysql --publish 3306:3306 --env MYSQL_DATABASE=db --env MYSQL_ROOT_PASSWORD=pass --health-cmd 'mysqladmin ping -h localhost -uroot -ppass' --health-interval 5s --health-timeout 5s --health-retries 5 mariadb:10 --secure-file-priv=""
    podman run --detach --replace --name connector-arrow-mssql --platform linux/amd64 --publish 1433:1433 --env ACCEPT_EULA=Y --env MSSQL_PID=Developer --env MSSQL_SA_PASSWORD=passwordA1 --env LC_ALL=en_US.UTF-8 --env MSSQL_COLLATION=Latin1_General_100_CS_AI_SC_UTF8 mcr.microsoft.com/mssql/server:2022-latest
    until podman healthcheck run connector-arrow-postgres; do sleep 1; done
    until podman healthcheck run connector-arrow-mysql; do sleep 1; done

stop:
    podman rm --force connector-arrow-postgres connector-arrow-mysql connector-arrow-mssql || true

# dbs not included in ci
seed-more:
    mysql --protocol tcp -h$MYSQL_HOST -P$MYSQL_PORT -u$MYSQL_USER -p$MYSQL_PASSWORD $MYSQL_DB < mysql.sql
    mssql-cli -S$MSSQL_HOST -U$MSSQL_USER -P$MSSQL_PASSWORD -d$MSSQL_DB -i mssql.sql
    mysql --protocol tcp -h$CLICKHOUSE_HOST -P$CLICKHOUSE_PORT -u$CLICKHOUSE_USER -p$CLICKHOUSE_PASSWORD $CLICKHOUSE_DB < clickhouse.sql
    psql $REDSHIFT_URL -f redshift.sql
    ORACLE_URL_SCRIPT=`echo ${ORACLE_URL#oracle://} | sed "s/:/\//"`
    cat oracle.sql | sqlplus $ORACLE_URL_SCRIPT
    mysql --protocol tcp -h$MARIADB_HOST -P$MARIADB_PORT -u$MARIADB_USER -p$MARIADB_PASSWORD $MARIADB_DB < mysql.sql
